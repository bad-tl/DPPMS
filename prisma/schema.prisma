// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id
  name            String
  email           String
  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  accounts        Account[]
  about           About?
  education       Education[]
  skills          Skill[]
  experience      Experience[]
  projects        Project[]
  certificates    Certificate[]
  contactProfile  ContactProfile?
  contactMessages ContactMessage[]

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Hero {
  id                   String   @id @default(cuid())
  fullName             String
  professionalTitle    String
  headline             String
  description          String   @db.Text
  profileImage         String?
  profileImagePublicId String?
  primaryButtonText    String   @default("View My Projects")
  primaryButtonLink    String   @default("#projects")
  secondaryButtonText  String   @default("Contact Me")
  secondaryButtonLink  String   @default("#contact")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model About {
  id     String @id @default(cuid())
  userId String @unique

  // Section content
  sectionTitle String @default("About Me")
  subtitle     String @default("A little about who I am")
  biography    String @default("")

  // Profile image stored in Cloudinary
  imageUrl      String?
  imagePublicId String?

  // Professional information
  professionalRole   String?
  professionalStatus String?
  yearsOfExperience  Int     @default(0)

  // Statistics
  projectsCompleted Int @default(0)
  happyClients      Int @default(0)

  // Visibility
  isVisible Boolean @default(true)

  // Relationships
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  highlights AboutHighlight[]
  strengths  AboutStrength[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AboutHighlight {
  id      String @id @default(cuid())
  aboutId String

  label     String
  value     String
  sortOrder Int    @default(0)

  about About @relation(fields: [aboutId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([aboutId, sortOrder])
}

model AboutStrength {
  id      String @id @default(cuid())
  aboutId String

  title       String
  description String?               @db.Text
  category    AboutStrengthCategory @default(STRENGTH)
  sortOrder   Int                   @default(0)

  about About @relation(fields: [aboutId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([aboutId, sortOrder])
}

enum AboutStrengthCategory {
  STRENGTH
  VALUE
  INTEREST
}

model Education {
  id           String  @id @default(cuid())
  userId       String
  institution  String
  degree       String
  fieldOfStudy String
  description  String? @db.Text

  startDate           DateTime
  endDate             DateTime?
  isCurrentlyStudying Boolean   @default(false)

  grade                   String?
  institutionLogo         String?
  institutionLogoPublicId String?

  isVisible Boolean @default(true)
  sortOrder Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, sortOrder])
}

model Skill {
  id     String @id @default(cuid())
  userId String

  name        String
  category    SkillCategory
  description String?       @db.Text

  // Self-assessed proficiency from 0 to 100
  proficiency Int @default(70)

  // Controls ordering on the public portfolio
  sortOrder Int @default(0)

  // Optional logo/icon URL and Cloudinary public ID
  icon         String?
  iconPublicId String?

  isVisible Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, category, sortOrder])
  @@index([userId, isVisible])
}

enum SkillCategory {
  PROGRAMMING_LANGUAGES
  FRAMEWORKS
  DATABASES
  TOOLS_AND_PLATFORMS
  TECHNICAL
  PROBLEM_SOLVING
  SOFT_SKILLS
  OTHER
}

model Experience {
  id     String @id @default(cuid())
  userId String

  // Professional information
  company        String
  position       String
  employmentType EmploymentType
  location       String?
  description    String?        @db.Text

  // Employment duration
  startDate          DateTime
  endDate            DateTime?
  isCurrentlyWorking Boolean   @default(false)

  // Company logo - Cloudinary
  companyLogo         String?
  companyLogoPublicId String?

  // Visibility and ordering
  isVisible Boolean @default(true)
  sortOrder Int     @default(0)

  // Relationships
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  highlights ExperienceHighlight[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, sortOrder])
  @@index([userId, isVisible])
}

model ExperienceHighlight {
  id           String @id @default(cuid())
  experienceId String

  content   String
  sortOrder Int    @default(0)

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([experienceId, sortOrder])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  FREELANCE
  SELF_EMPLOYED
  VOLUNTEER
  OTHER
}

enum ProjectStatus {
  COMPLETED
  IN_PROGRESS
  PLANNED
}

model Project {
  id     String @id @default(cuid())
  userId String

  // Basic information
  title            String
  slug             String
  shortDescription String? @db.Text
  description      String? @db.Text

  // Project details
  role         String?
  category     String?
  technologies String[] @default([])

  // Project links
  liveUrl       String?
  sourceCodeUrl String?
  caseStudyUrl  String?

  // Project timeline
  startDate DateTime?
  endDate   DateTime?
  status    ProjectStatus @default(COMPLETED)

  // Main cover image
  coverImage         String?
  coverImagePublicId String?

  // Display settings
  isFeatured Boolean @default(false)
  isVisible  Boolean @default(true)
  sortOrder  Int     @default(0)

  // Relationships
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  images     ProjectImage[]
  highlights ProjectHighlight[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slug])
  @@index([userId, sortOrder])
  @@index([userId, isVisible])
  @@index([userId, isFeatured])
}

model ProjectImage {
  id        String @id @default(cuid())
  projectId String

  imageUrl String
  publicId String
  alt      String?

  sortOrder Int @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId, sortOrder])
}

model ProjectHighlight {
  id        String @id @default(cuid())
  projectId String

  content   String
  sortOrder Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId, sortOrder])
}

model Certificate {
  id String @id @default(cuid())

  // Basic information
  title       String
  issuer      String
  description String? @db.Text

  // Certificate details
  issueDate      DateTime
  expirationDate DateTime?
  credentialId   String?
  credentialUrl  String?

  // Certificate media (Cloudinary URLs)
  imageUrl    String?
  documentUrl String?

  // Related skills / technologies
  skills String[] @default([])

  // Publishing and display
  isVisible  Boolean @default(true)
  isFeatured Boolean @default(false)
  sortOrder  Int     @default(0)

  // Ownership
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isVisible, sortOrder])
  @@index([userId, issueDate])
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

model ContactProfile {
  id           String  @id @default(cuid())
  intro        String? @db.Text
  phone        String?
  email        String?
  address      String?
  workingHours String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  socialLinks SocialLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model SocialLink {
  id        String  @id @default(cuid())
  platform  String
  label     String?
  url       String
  isVisible Boolean @default(true)
  sortOrder Int     @default(0)

  contactProfileId String
  contactProfile   ContactProfile @relation(fields: [contactProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contactProfileId, platform])
  @@index([contactProfileId, isVisible, sortOrder])
}

model ContactMessage {
  id      String @id @default(cuid())
  name    String
  email   String
  subject String
  message String @db.Text

  status      ContactMessageStatus @default(NEW)
  emailSentAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status])
}
